# Motor Trends Auto Group - Apache / cPanel Configuration
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule lsapi_module>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/webp .webp
</IfModule>

# Browser caching prevention for JSON API data
<Files "vehicles.json">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</Files>

# ----------------------------------------------------
# Clean URLs (Remove .html extension across all pages)
# ----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect /index.html or /index to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index(\.html)?[\s\?] [NC]
  RewriteRule ^(.*)index(\.html)?$ /$1 [R=301,L]

  # 2. 301 Redirect any direct *.html request to clean extensionless URL
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)\.html[\s\?] [NC]
  RewriteRule ^(.*)\.html$ /$1 [R=301,L]

  # 3. Internally rewrite extensionless request to existing .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
